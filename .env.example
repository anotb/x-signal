# The app makes no OpenAI API calls and does not use OPENAI_API_KEY.
# Optional. Required only by the opt-in `chatgpt` Secure MCP Tunnel profile.
# Configure this and the ignored key file with: npm run tunnel:secure:configure
OPENAI_TUNNEL_ID=
XSIGNAL_PORT=7345
XSIGNAL_BROWSER_CDP_URL=http://browser:9223
XSIGNAL_DATA_DIR=/data
XSIGNAL_LOG_LEVEL=info
XSIGNAL_MAX_BROWSER_CONCURRENCY=2
XSIGNAL_REQUEST_SPACING_MS=900
# Optional. If omitted, the browser creates a stable random VNC password in its named volume.
# XSIGNAL_VNC_PASSWORD=
# The Compose file binds noVNC and the sidecar CDP debugger to host loopback only.
# Optional bearer protection for a managed remote MCP endpoint. Leave unset for local use and for the documented path-gated ChatGPT fallback.
# XSIGNAL_MCP_BEARER_TOKEN=
# Monitor webhooks require public HTTPS by default. Enable only for an intentional loopback/private development sink.
# XSIGNAL_ALLOW_PRIVATE_MONITOR_SINKS=0
